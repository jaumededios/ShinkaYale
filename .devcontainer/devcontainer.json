{
  "name": "shinka-agents",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "secrets": {
    "OPENROUTER_API_KEY": {
      "description": "OpenRouter API key — create one at https://openrouter.ai/keys"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}"
  },
  "onCreateCommand": "bash .devcontainer/post-create.sh",
  "postAttachCommand": "bash .devcontainer/post-attach.sh",
  "portsAttributes": {
    "8888": {
      "label": "Shinka WebUI",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.editorAssociations": {
          "**/README.md": "vscode.markdown.preview.editor"
        }
      }
    }
  },
  "forwardPorts": [8888]
}
